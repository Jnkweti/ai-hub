<UserControl x:Class="AIHub.Desktop.Controls.AgentRequestCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
  <Style x:Key="Choice" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Outline" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="16" Height="16" CornerRadius="3" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,8,0"><TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource CyanBrush}" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"/></Border>
      <ContentPresenter Grid.Column="1"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Outline" Property="Background" Value="{StaticResource CodexSurfaceBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Padding="14" Margin="0,10,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2,0,0,0" CornerRadius="3">
  <StackPanel>
   <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource CyanBrush}" FontSize="12" Margin="12,2,0,0" AutomationProperties.AutomationId="RequestStatus"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
   <ItemsControl ItemsSource="{Binding Choices}" IsEnabled="{Binding IsPending}" PreviewKeyDown="Choices_KeyDown" AutomationProperties.AutomationId="RequestChoices">
    <ItemsControl.ItemTemplate><DataTemplate>
     <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource Choice}" AutomationProperties.Name="{Binding Label}">
      <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/></StackPanel>
     </CheckBox>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <StackPanel Visibility="{Binding IsPending, Converter={StaticResource VisibleIfTrue}}">
    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,10"/>
    <WrapPanel>
     <Button Content="Send answer" Click="Submit_Click" IsEnabled="{Binding CanSend}" Visibility="{Binding IsQuestion, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,8,4" AutomationProperties.AutomationId="RequestSend"/>
     <Button Content="Type an answer" Click="Activate_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="RequestWrite"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsQuestion}" Value="True"/><Condition Binding="{Binding AllowFreeText}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Allow once" Click="Allow_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="RequestAllow"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsQuestion}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Decline" Click="Decline_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,4" AutomationProperties.AutomationId="RequestDecline"/>
    </WrapPanel>
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
