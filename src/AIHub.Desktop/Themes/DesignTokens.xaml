  <GradientStop Color="#0D1B22" Offset="0.35"/>
  <GradientStop Color="#0A1116" Offset="0.8"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="InstrumentBrush" StartPoint="0,0" EndPoint="1,0.8">
  <GradientStop Color="#132A30" Offset="0"/>
  <GradientStop Color="#101D24" Offset="0.55"/>
  <GradientStop Color="#211E1C" Offset="1"/>
 </LinearGradientBrush>
 <CornerRadius x:Key="ControlRadius">6</CornerRadius>
 <CornerRadius x:Key="ComposerRadius">12</CornerRadius>
</ResourceDictionary>
