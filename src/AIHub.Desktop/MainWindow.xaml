<Window x:Class="AIHub.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AIHub.Desktop"
 xmlns:ui="clr-namespace:AIHub.Desktop.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="AI Hub" Style="{StaticResource {x:Type Window}}" Width="1500" Height="960" MinWidth="1080" MinHeight="700"
 WindowStyle="None" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged"
 PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources><local:ActivityAgentColor x:Key="ActivityAgentColor"/></Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource AtmosphereBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,0,4,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Data="M 0,0 L 0,18 M 14,0 L 14,18 M 0,9 L 14,9 M 6,5 L 8,5 M 6,13 L 8,13" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" Width="16" Height="20" Margin="0,0,12,0"/>
      <TextBlock Text="AI Hub" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border Width="1" Height="16" Background="{StaticResource LineBrush}" Margin="20,0"/>
      <TextBlock Text="A shared workspace for human + AI" Style="{StaticResource Label}" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
      <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/>
      <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close AI Hub" AutomationProperties.Name="Close AI Hub"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="NavigationRail" Background="{StaticResource PanelBrush}" Padding="16,26,16,16">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <TextBlock x:Name="WorkspaceHeading" Text="Workspace" FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="10,0,0,20"/>
       <Button x:Name="NewRoomButton" Click="NewRoom_Click" Style="{StaticResource PrimaryButton}" Padding="12,12" Margin="0,0,0,16" ToolTip="New conversation (Ctrl+N)" AutomationProperties.Name="New conversation">
        <StackPanel Orientation="Horizontal"><ui:HubIcon Kind="plus" Width="16" Height="16" Margin="0,0,9,0"/><TextBlock Text="New conversation"/></StackPanel>
       </Button>
       <Grid Margin="0,0,0,16">
        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="11,9" FontSize="13" Background="{StaticResource CanvasBrush}" AutomationProperties.Name="Search conversations" ToolTip="Search conversations and project paths (Ctrl+K)"/>
        <TextBlock x:Name="SearchHint" Text="Search conversations" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="12,10" IsHitTestVisible="False"/>
       </Grid>
       <TextBlock x:Name="ConversationsHeading" Text="Conversations" Style="{StaticResource Label}" Margin="10,0,0,12"/>
       <ComboBox x:Name="RoomFilter" SelectedIndex="0" SelectionChanged="RoomFilter_SelectionChanged" Margin="0,0,0,12" FontSize="12" AutomationProperties.Name="Conversation view" ToolTip="Show active or archived conversations"><ComboBoxItem Content="Active conversations"/><ComboBoxItem Content="Archived conversations"/></ComboBox>
       <TextBlock x:Name="SearchEmpty" Text="No matching conversations" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="10,0,10,12" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
       <Border x:Name="SharedProjectCard" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14" Margin="0,16,0,16">
        <StackPanel>
         <StackPanel Orientation="Horizontal"><ui:HubIcon Kind="folder-open" Width="15" Height="15" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0"/><TextBlock Text="Shared project" Style="{StaticResource Label}"/></StackPanel>
         <TextBlock x:Name="WorkspaceLabel" Text="Choose a folder" TextTrimming="CharacterEllipsis" Margin="0,9,0,12" FontSize="14" FontWeight="Medium"/>
         <Button x:Name="ChooseFolderButton" Content="Change folder" Click="ChooseFolder_Click" Padding="8,7" FontSize="12" ToolTip="Choose the project both agents work with (Ctrl+O)"/>
         <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="ProjectStatusButton" Content="Check status" Click="ProjectStatus_Click" Padding="8,7" FontSize="12" AutomationProperties.Name="Check project status"/>
          <Button x:Name="StatusActionsButton" Grid.Column="1" Content="⋯" Click="StatusActions_Click" Padding="8,4" Margin="4,0,0,0" ToolTip="Refresh or forget saved project status" AutomationProperties.Name="Project status options">
           <Button.ContextMenu><ContextMenu><MenuItem x:Name="RefreshStatusMenuItem" Header="Refresh status" Click="RefreshStatus_Click" ToolTip="Run a fresh inspection even when the saved report matches"/><MenuItem x:Name="ForgetStatusMenuItem" Header="Forget saved status" Click="ForgetStatus_Click"/></ContextMenu></Button.ContextMenu>
          </Button>
         </Grid>
         <Button x:Name="TasksButton" Content="Tasks and notes" Click="Tasks_Click" Padding="8,7" FontSize="12" Margin="0,8,0,0" AutomationProperties.Name="Project tasks and notes"/>
         <TextBlock x:Name="TaskSummaryLabel" Text="No active tasks" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
       </Border>
       <Button x:Name="RenameButton" Click="Rename_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,9" Content="Rename conversation" ToolTip="Rename this conversation (F2)"/>
       <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ArchiveButton" Content="Archive conversation" Click="Archive_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,9" FontSize="12" ToolTip="Keep this conversation in the archive"/>
        <Button x:Name="DeleteConversationButton" Grid.Column="1" Content="Delete" Click="DeleteConversation_Click" Style="{StaticResource QuietButton}" Foreground="{StaticResource DangerBrush}" Padding="8,9" FontSize="12" AutomationProperties.Name="Delete conversation" ToolTip="Permanently delete this conversation"/>
       </Grid>
       <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,9"><StackPanel Orientation="Horizontal"><ui:HubIcon Kind="download" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="Export conversation"/></StackPanel></Button>
       <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="10,10" Margin="0,6,0,0" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><ui:HubIcon Kind="settings-2" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="Settings"/></StackPanel></Button>
      </StackPanel>
      <ListBox x:Name="RoomList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" SelectionChanged="RoomList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" ToolTip="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Grid><Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="Selection" Background="{StaticResource CyanBrush}" Width="3" Height="18" HorizontalAlignment="Left" Visibility="Collapsed" CornerRadius="1"/></Grid>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}"/><Setter TargetName="Selection" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderThickness" Value="1"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
      </ListBox>
     </DockPanel>
    </Border>
    <Grid Grid.Column="1" ClipToBounds="True">
     <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="28,22,24,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Shared conversation" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBlock x:Name="RoomTitle" Text="New conversation" Style="{StaticResource Heading}" FontSize="24" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="StopButton" Click="Stop_Click" Background="#2C2027" BorderBrush="#66404A" Foreground="{StaticResource DangerBrush}" Padding="12,9" Margin="0,0,8,0" ToolTip="Stop both agents (Esc)" AutomationProperties.Name="Stop all"><StackPanel Orientation="Horizontal"><ui:HubIcon Kind="square" Width="12" Height="12" Margin="0,0,8,0"/><TextBlock Text="Stop all"/></StackPanel></Button>
       <Button x:Name="ActivityToggle" Click="ActivityToggle_Click" Style="{StaticResource QuietButton}" Padding="10,9" ToolTip="Show or hide the activity timeline" AutomationProperties.Name="Show or hide activity"><StackPanel Orientation="Horizontal"><ui:HubIcon Kind="panel-right-close" x:Name="ActivityToggleIcon" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Activity"/></StackPanel></Button>
      </StackPanel>
     </Grid>
     <!-- Actual agent states and dispatches drive this instrument. -->
     <Border x:Name="CollaborationInstrument" Grid.Row="1" Margin="24,0,24,12" Background="{StaticResource InstrumentBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="16,12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="CodexCard" CornerRadius="6" Background="Transparent" Padding="0,3,8,3">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource CodexSurfaceBrush}" VerticalAlignment="Center"><ui:HubIcon Kind="terminal" Width="17" Height="17" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Codex" FontSize="15" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="CodexPulse" Width="5" Height="5" Fill="{StaticResource CyanBrush}" Opacity="0.4" Margin="0,0,7,0"/><TextBlock x:Name="CodexStatus" Text="Standby" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></StackPanel>
         </Grid>
         <TextBlock x:Name="CodexDetail" Text="Ready for your direction" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,9,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
        <TextBlock x:Name="RoundLabel" Text="Ready" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <ui:CollaborationLink x:Name="HandoffSignal" Height="28" Margin="0,4"/>
        <TextBlock x:Name="HandoffLink" Text="Shared workspace" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
       </StackPanel>
       <Border x:Name="ClaudeCard" Grid.Column="2" CornerRadius="6" Background="Transparent" Padding="8,3,0,3">
        <StackPanel>
         <Grid HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource ClaudeSurfaceBrush}" VerticalAlignment="Center"><ui:HubIcon Kind="sparkles" Width="17" Height="17" Foreground="{StaticResource ClaudeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Claude Code" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0"><Ellipse x:Name="ClaudePulse" Width="5" Height="5" Fill="{StaticResource ClaudeBrush}" Opacity="0.4" Margin="0,0,7,0"/><TextBlock x:Name="ClaudeStatus" Text="Standby" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></StackPanel>
         </Grid>
         <TextBlock x:Name="ClaudeDetail" Text="Ready for your direction" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
     <Grid Grid.Row="2" x:Name="ConversationSurface">
      <Grid x:Name="Welcome" Margin="40,20,40,24">
       <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="600">
         <Grid Width="104" Height="58" HorizontalAlignment="Left" Margin="0,0,0,26" IsHitTestVisible="False">
          <Path Data="M 2,28 L 28,2 54,28 28,54 Z M 50,28 L 76,2 102,28 76,54 Z" Stroke="#41636A" StrokeThickness="1"/>
          <Path Data="M 28,16 L 28,40 M 76,16 L 76,40 M 28,28 L 76,28" Stroke="{StaticResource CyanBrush}" StrokeThickness="2"/>
          <Ellipse Width="6" Height="6" Fill="{StaticResource ClaudeBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0"/>
         </Grid>
         <TextBlock Text="Two perspectives.&#x0a;One workspace." Style="{StaticResource Heading}" FontSize="38" LineHeight="49"/>
         <TextBlock Text="Give your agents a direction. Follow the conversation,&#x0a;see the work, and step in whenever you need to." Foreground="{StaticResource MutedBrush}" FontSize="16" LineHeight="26" Margin="0,18,0,28"/>
         <StackPanel Orientation="Horizontal">
          <Button Click="Suggestion_Click" Tag="review" Padding="16,12" Margin="0,0,12,0" Background="{StaticResource CodexSurfaceBrush}" BorderThickness="0"><StackPanel Orientation="Horizontal"><ui:HubIcon Kind="folder-open" Width="17" Height="17" Foreground="{StaticResource CyanBrush}" Margin="0,0,10,0"/><TextBlock Text="Review a project"/><ui:HubIcon Kind="arrow-up-right" Width="15" Height="15" Margin="14,0,0,0"/></StackPanel></Button>
          <Button Click="Suggestion_Click" Tag="plan" Style="{StaticResource QuietButton}" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Plan something new"/><ui:HubIcon Kind="arrow-up-right" Width="15" Height="15" Margin="12,0,0,0"/></StackPanel></Button>
         </StackPanel>
         <TextBlock Text="Both agents use the project selected in your workspace." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,24,0,0"/>
        </StackPanel>
       </Viewbox>
      </Grid>
      <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" ScrollChanged="ChatScroll_ScrollChanged">
       <ItemsControl x:Name="MessageList" Margin="28,14,28,20" MaxWidth="920" HorizontalAlignment="Stretch">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border x:Name="MessageSurface" Margin="0,0,0,22" Padding="12,14" CornerRadius="6" Background="Transparent">
          <StackPanel>
           <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AvatarBackground}"><ui:HubIcon Kind="{Binding IconKind}" Foreground="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15"/></Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Speaker}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,1,0,0"/></StackPanel>
            <Button Grid.Column="2" Click="Copy_Click" Style="{StaticResource QuietButton}" Padding="7" ToolTip="Copy message" AutomationProperties.Name="Copy message"><ui:HubIcon Kind="copy" Width="15" Height="15"/></Button>
           </Grid>
           <ui:MarkdownView Markdown="{Binding BodyText}"/>
           <Expander x:Name="CollaborationDetails" Header="Review scope, findings and evidence" Visibility="Collapsed" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}">
            <ui:MarkdownView Markdown="{Binding Text}" Margin="0,10,0,0"/>
           </Expander>
           <ui:AgentRequestCard DataContext="{Binding Request}" Activated="Request_Activated" Submitted="Request_Submitted" Declined="Request_Declined" Allowed="Request_Allowed" AutomationProperties.AutomationId="AgentRequestCard" AutomationProperties.Name="{Binding AgentName}"/>
          </StackPanel>
         </Border>
         <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsStructured}" Value="True"><Setter TargetName="CollaborationDetails" Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding Speaker}" Value="You"><Setter TargetName="MessageSurface" Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter TargetName="MessageSurface" Property="Padding" Value="18,16"/></DataTrigger>
          <DataTrigger Binding="{Binding Speaker}" Value="AI Hub"><Setter TargetName="MessageSurface" Property="Background" Value="{StaticResource PanelBrush}"/><Setter TargetName="MessageSurface" Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter TargetName="MessageSurface" Property="BorderThickness" Value="2,0,0,0"/><Setter TargetName="MessageSurface" Property="Padding" Value="16"/></DataTrigger>
         </DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <Button x:Name="LatestButton" Content="↓  Latest messages" Click="Latest_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,12" Visibility="Collapsed" Padding="12,8" Background="{StaticResource HoverBrush}"/>
     </Grid>
     <Border x:Name="CommandSurface" Grid.Row="3" Padding="24,12,24,20" Background="{StaticResource CanvasBrush}">
      <StackPanel MaxWidth="944">
       <Border x:Name="ArchivedBanner" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="2,0,0,0" CornerRadius="3" Padding="12" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="Archived conversation" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="You can read or export it. Restore it to message your agents." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
         <Button x:Name="RestoreConversationButton" Grid.Column="1" Content="Restore to continue" Click="Archive_Click" Padding="10,7" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
       </Border>
       <Border x:Name="PauseBanner" Visibility="Collapsed" Background="#202923" BorderBrush="{StaticResource ClaudeBrush}" BorderThickness="2,0,0,0" CornerRadius="3" Padding="12" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="Collaboration paused" Foreground="{StaticResource ClaudeBrush}" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="PauseReasonLabel" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ContinueButton" Content="Continue task" Click="Continue_Click" Padding="10,7" FontSize="12" Visibility="Collapsed"/><Button x:Name="FocusMessageButton" Content="Write a message" Click="FocusMessage_Click" Style="{StaticResource QuietButton}" Padding="8,6" FontSize="12"/></StackPanel>
        </Grid>
       </Border>
       <DockPanel x:Name="AnswerBanner" Visibility="Collapsed" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" x:Name="ShowQuestionButton" Content="Show question" Click="ShowQuestion_Click" Style="{StaticResource QuietButton}" Padding="6,3" FontSize="12"/>
        <TextBlock x:Name="AnswerLabel" Foreground="{StaticResource CyanBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </DockPanel>
       <Button x:Name="ImportFilesButton" Content="Import files" Click="ImportFiles_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="8,5" FontSize="12" ToolTip="Copy files into this conversation's project folder and add references to your draft. Existing files are kept." AutomationProperties.Name="Import files"/>
       <Border x:Name="ComposerFrame" BorderBrush="#41606B" BorderThickness="1" CornerRadius="{StaticResource ComposerRadius}" Background="{StaticResource SurfaceBrush}" Padding="3">
        <Grid>
         <TextBox x:Name="Composer" MinHeight="70" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontSize="15" Padding="14" PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" GotKeyboardFocus="Composer_GotFocus" LostKeyboardFocus="Composer_LostFocus" AutomationProperties.Name="Message your agents" ToolTip="Enter to send; Shift+Enter for a new line."/>
         <PasswordBox x:Name="SecretAnswer" Visibility="Collapsed" MinHeight="70" Padding="14" FontSize="15" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" PasswordChanged="SecretAnswer_Changed" PreviewKeyDown="Composer_PreviewKeyDown" AutomationProperties.Name="Private answer" ToolTip="This answer is masked and is not saved in the conversation."/>
         <TextBlock x:Name="ComposerHint" Text="Give your agents a direction…" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="{Binding Padding, ElementName=Composer}" IsHitTestVisible="False"/>
        </Grid>
       </Border>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="AutoToggle" Content="Auto collaborate" IsChecked="True" Checked="AutoToggle_Changed" Unchecked="AutoToggle_Changed" FontSize="12" VerticalAlignment="Center" ToolTip="Agents pause for greetings, completion, your input, repeated replies, or the round limit in Settings."/>
        <ComboBox Grid.Column="1" x:Name="Target" SelectedIndex="0" SelectionChanged="Target_SelectionChanged" Margin="10,0,8,0" FontSize="13" AutomationProperties.Name="Message recipient"><ComboBoxItem Content="Both agents"/><ComboBoxItem Content="Codex only"/><ComboBoxItem Content="Claude only"/></ComboBox>
        <Button Grid.Column="2" x:Name="SendButton" Click="Send_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Padding="16,9" AutomationProperties.Name="Send message"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SendLabel" Text="Send" Margin="0,0,10,0"/><ui:HubIcon Kind="send" Width="15" Height="15"/></StackPanel></Button>
       </Grid>
       <Grid Margin="0,11,0,0"><TextBlock Text="Enter to send    Shift+Enter for a new line" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Button Click="Settings_Click" Style="{StaticResource QuietButton}" Padding="0" HorizontalAlignment="Right" ToolTip="Change project permissions in Settings" AutomationProperties.Name="Project permissions"><TextBlock x:Name="ModeLabel" Text="Read only" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Button></Grid>
      </StackPanel>
     </Border>
    </Grid>
    <Border x:Name="ActivityRail" Grid.Column="2" Width="294" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" ClipToBounds="True">
     <DockPanel Margin="20,26,20,20" MinWidth="252">
      <StackPanel DockPanel.Dock="Top">
       <Grid Margin="0,0,0,8"><TextBlock Text="Live activity" FontFamily="{StaticResource DisplayFont}" FontSize="18"/><ui:HubIcon Kind="activity" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
       <TextBlock Text="Actions, results, and handoffs." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>
       <CheckBox x:Name="DiagnosticsToggle" Content="Show diagnostics" Checked="DiagnosticsToggle_Changed" Unchecked="DiagnosticsToggle_Changed" FontSize="12" Margin="0,0,0,16" ToolTip="Show recent raw events, including token usage, connection messages, and output chunks" AutomationProperties.Name="Show diagnostics"/>
       <Grid Margin="0,0,0,14"><TextBlock x:Name="ActivityScopeLabel" Text="Recent actions" Style="{StaticResource Label}"/><TextBlock x:Name="ActivityCount" Text="0" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/></Grid>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="Select an action to view its output." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/><Button x:Name="OpenActivityLogButton" Content="Open full log" Click="OpenActivityLog_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="12" Padding="0,8" ToolTip="Open this conversation's complete recorded activity in Notepad"/></StackPanel>
      <Grid>
       <StackPanel x:Name="ActivityEmpty" VerticalAlignment="Center" Margin="18,0,18,30">
        <ui:HubIcon Kind="activity" Width="34" Height="34" Foreground="#52757B" HorizontalAlignment="Center"/>
        <TextBlock Text="A window into the work" FontSize="14" FontWeight="Medium" TextAlignment="Center" Margin="0,18,0,8"/>
        <TextBlock Text="Tools, handoffs, and requests for your input will appear here." FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21"/>
       </StackPanel>
       <ListBox x:Name="ActivityList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ActivityList_SelectionChanged">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="EventBorder" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EventBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EventBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="EventBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="1" Background="{StaticResource LineBrush}" HorizontalAlignment="Center"/>
          <Ellipse Width="5" Height="5" Fill="{Binding Agent, Converter={StaticResource ActivityAgentColor}}" VerticalAlignment="Top" Margin="0,17,0,0"/>
          <StackPanel Grid.Column="1" Margin="6,10,4,14"><Grid><TextBlock Text="{Binding Agent}" Foreground="{Binding Agent, Converter={StaticResource ActivityAgentColor}}" FontSize="12" FontWeight="Medium"/><TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" MaxHeight="60" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" FontSize="11" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Needs attention"><Setter Property="Foreground" Value="{StaticResource ClaudeBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </DockPanel>
    </Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource CanvasBrush}" Padding="22,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse x:Name="SystemPulse" Width="5" Height="5" Fill="{StaticResource CyanBrush}" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,9,0"/>
     <TextBlock x:Name="StateLabel" Grid.Column="1" Text="Ready when you are" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="VersionLabel" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
