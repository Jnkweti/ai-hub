# Normalize text in Git; keep Windows launch scripts native when checked out.
* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.xaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
*.ttf binary
